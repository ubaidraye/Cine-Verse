<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-25">

        <!-- Orbit ring: back half (behind the play button) -->
        <path
            android:pathData="M28,54 a26,11 0 0,1 52,0"
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round" />
    </group>

    <!-- Play button -->
    <path
        android:pathData="M45,40 L45,68 L70,54 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="4"
        android:strokeColor="#FFFF4081">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="40"
                android:endX="70"
                android:endY="68"
                android:type="linear">
                <item android:color="#FFFF4081" android:offset="0.0" />
                <item android:color="#FF7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-25">

        <!-- Orbit ring: front half (in front of the play button) -->
        <path
            android:pathData="M28,54 a26,11 0 0,0 52,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.6"
            android:strokeLineCap="round" />

        <!-- Planet -->
        <path
            android:fillColor="#FF00E5FF"
            android:pathData="M80,54 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    </group>
</vector>
